// components/UserFormModal.js
import React, { useState, useEffect } from "react";

const UserFormModal = ({ formData, setFormData, onSubmit, onClose, isEdit = false }) => {
  const [imagePreview, setImagePreview] = useState("");

  useEffect(() => {
    if (isEdit && formData.profileImageUrl) {
      setImagePreview(formData.profileImageUrl);  // Set initial image preview if editing
    }
  }, [formData.imageUrl, isEdit]);

  const handleChange = (e) => {
    const { name, value, files, type } = e.target;

    if (type === "file") {
      const file = files[0];  
      setFormData((prev) => ({
        ...prev,
        imageFile: file })); // Store the file for upload
        if (file) {
        setImagePreview(URL.createObjectURL(file)); // Preview the image
      } else {
        setImagePreview(""); // Clear preview if no file
      }       
    } else {
      setFormData((prev) => ({
        ...prev,
        [name]: value,
      }));
    }
  };

  return (
    <div
      className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
      onClick={onClose}
    >
      <div
        className="bg-white rounded-lg shadow-lg max-w-3xl w-full max-h-[90vh] overflow-y-auto p-6"
        onClick={(e) => e.stopPropagation()}
      >
        <form onSubmit={onSubmit} encType="multipart/form-data">
          <h3 className="text-lg font-semibold mb-4">
            {isEdit ? "Edit User Details" : "New User Details"}
          </h3>
            {isEdit && (
              <label className="block text-sm font-medium text-gray-700 mb-2">
                User ID: {formData.id}
              </label>
            )}
          <div className="grid grid-cols-2 gap-4 mb-4">
          <div className="col-span-2">
              <label className="block mb-1 font-medium">Profile Image</label>
              <input
                type="file"
                accept="image/*"
                onChange={handleChange}
                name="imageFile"
                className="border px-3 py-2 rounded w-full"
              />
              {imagePreview && (
                <img
                  src={imagePreview}
                  alt="Preview"
                  className="mt-2 max-h-40 rounded object-cover border"
                />
              )}
            </div>
            <input
              name="username"
              type="text"
              placeholder="Username"
              value={formData.username ?? ""} 
              onChange={handleChange}
              required
              className="border px-3 py-2 rounded w-full"
            />
            {!isEdit && (
              <input
                name="password"
                type="password"
                placeholder="Password"
                value={formData.password ?? ""}
                onChange={handleChange}
                required
                className="border px-3 py-2 rounded w-full"
              />
            )}
            <select
              name="account_type"
              value={formData.account_type}
              onChange={handleChange}
              required
              className="border px-3 py-2 rounded w-full"
              disabled={isEdit} // prevent account type change while editing
            >
              <option value="" disabled>
                Select Account Type
              </option>
              <option value="student">Student</option>
              <option value="tutor">Tutor</option>
              <option value="admin staff">Admin Staff</option>
              <option value="admin">Admin</option>
            </select>
            <input
              name="fname"
              type="text"
              placeholder="First Name"
              value={formData.fname || ""}
              onChange={handleChange}
              required
              className="border px-3 py-2 rounded w-full"
            />
            <input
              name="mname"
              type="text"
              placeholder="Middle Name"
              value={formData.mname || ""}
              onChange={handleChange}
              className="border px-3 py-2 rounded w-full"
            />
            <input
              name="lname"
              type="text"
              placeholder="Last Name"
              value={formData.lname || ""}
              onChange={handleChange}
              required
              className="border px-3 py-2 rounded w-full"
            />
            <input
              name="birthdate"
              type="date"
              value={formData.birthdate || ""}
              onChange={handleChange}
              className="border px-3 py-2 rounded w-full"
              required
            />
            <input
              name="email"
              type="email"
              placeholder="Email"
              value={formData.email || ""}
              onChange={handleChange}
              className="border px-3 py-2 rounded w-full"
            />
            <input
              name="contact_no"
              type="text"
              placeholder="Contact No."
              value={formData.contact_no || ""}
              onChange={(e) => {
                const input = e.target.value;
                // Allow only digits and limit to 11 characters
                if (/^\d{0,11}$/.test(input)) {
                  handleChange(e);
                }
              }}
              className="border px-3 py-2 rounded w-full"
            />
          </div>

          {/* Student Fields */}
          {formData.account_type === "student" && (
            <div className="grid grid-cols-2 gap-4 mb-4">
              <h4 className="col-span-2 text-md font-semibold">
                Parent Information
              </h4>
              <input
                name="parent_fname"
                type="text"
                placeholder="Parent First Name"
                value={formData.parent_fname || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
              <input
                name="parent_mname"
                type="text"
                placeholder="Parent Middle Name"
                value={formData.parent_mname || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
              <input
                name="parent_lname"
                type="text"
                placeholder="Parent Last Name"
                value={formData.parent_lname || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
              <input
                name="parent_suffix"
                type="text"
                placeholder="Parent Suffix"
                value={formData.parent_suffix || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
              <input
                name="parent_email"
                type="email"
                placeholder="Parent Email"
                value={formData.parent_email || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
              <input
                name="parent_contact_no"
                type="text"
                placeholder="Parent Contact No."
                value={formData.parent_contact_no || ""}
                onChange={(e) => {
                  const input = e.target.value;
                  // Allow only digits and limit to 11 characters
                  if (/^\d{0,11}$/.test(input)) {
                    handleChange(e);
                  }
                }}
                className="border px-3 py-2 rounded w-full"
              />
            </div>
          )}

          {/* Tutor Fields */}
          {formData.account_type === "tutor" && (
            <div className="grid grid-cols-2 gap-4 mb-4">
              <h4 className="col-span-2 text-md font-semibold">Tutor Profile</h4>
              <input
                name="certification"
                type="text"
                placeholder="Certification"
                value={formData.certification || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
              <input
                name="teaching_lvl"
                type="text"
                placeholder="Teaching Level"
                value={formData.teaching_lvl || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
              <input
                name="subject"
                type="text"
                placeholder="Subject"
                value={formData.subject || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
              <input
                name="experiences"
                type="text"
                placeholder="experiences"
                value={formData.experiences || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
              <input
                name="graduate_at"
                type="text"
                placeholder="Graduate At"
                value={formData.graduate_at || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
              <input
                name="major"
                type="text"
                placeholder="Major"
                value={formData.major || ""}
                onChange={handleChange}
                className="border px-3 py-2 rounded w-full"
              />
            </div>
          )}

          <div className="flex justify-end gap-4">
            <button
              type="button"
              onClick={onClose}
              className="bg-gray-400 text-white px-4 py-2 rounded hover:bg-gray-500"
            >
              Cancel
            </button>
            <button
              type="submit"
              className="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700"
            >
              {isEdit ? 'Update User' : 'Save User'}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};

export default UserFormModal;
